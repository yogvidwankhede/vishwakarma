{
  "name": "vishwakarma",
  "version": "0.1.0",
  "private": true,
  "description": "The AI frontend engineering ecosystem. Skills, design intelligence, motion, and components that any coding agent can install.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "turbo run clean && rimraf node_modules",
    "vk": "node packages/cli/dist/index.js",
    "skills:compile": "pnpm --filter @vishwakarma/cli exec vishwakarma sync --all",
    "plugin:build": "node scripts/build-plugin.mjs",
    "plugin:check": "node scripts/build-plugin.mjs --check",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "audit:originality": "node scripts/audit-originality.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "turbo run build --filter=./packages/* && changeset publish",
    "prepare": "husky || true",
    "license:headers": "node scripts/apply-license-headers.mjs",
    "license:check": "node scripts/apply-license-headers.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@changesets/cli": "^2.29.0",
    "@types/node": "^22.15.0",
    "husky": "^9.1.7",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "ai",
    "agent-skills",
    "frontend",
    "ui",
    "ux",
    "design-system",
    "react",
    "nextjs",
    "tailwindcss",
    "animation",
    "motion",
    "mcp",
    "claude-code",
    "cursor"
  ]
}
