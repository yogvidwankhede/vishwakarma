{
  "name": "@vishwakarma/prompts",
  "version": "0.1.0",
  "description": "Composable prompt library for frontend generation, review, and refactoring.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "vishwakarma",
    "prompts",
    "prompt-engineering",
    "ai",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishwakarma-dev/vishwakarma.git",
    "directory": "packages/prompts"
  },
  "homepage": "https://github.com/vishwakarma-dev/vishwakarma/tree/main/packages/prompts#readme",
  "bugs": "https://github.com/vishwakarma-dev/vishwakarma/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
