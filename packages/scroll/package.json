{
  "name": "@vishwakarma/scroll",
  "version": "0.1.0",
  "description": "Scroll experiences: reveals, scroll-linked animation, pinned sequences, and parallax that degrades safely.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "vishwakarma",
    "scroll",
    "animation",
    "intersection-observer",
    "gsap",
    "scrolltrigger"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishwakarma-dev/vishwakarma.git",
    "directory": "packages/scroll"
  },
  "homepage": "https://github.com/vishwakarma-dev/vishwakarma/tree/main/packages/scroll#readme",
  "bugs": "https://github.com/vishwakarma-dev/vishwakarma/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@vishwakarma/core": "workspace:*",
    "@vishwakarma/motion": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "gsap": "^3.13.0"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
