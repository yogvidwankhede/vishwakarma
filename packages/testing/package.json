{
  "name": "@vishwakarma/testing",
  "version": "0.1.0",
  "description": "Test utilities for accessibility, motion, contract conformance, and viewport sweeps.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "vishwakarma",
    "testing",
    "accessibility",
    "axe",
    "vitest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishwakarma-dev/vishwakarma.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/vishwakarma-dev/vishwakarma/tree/main/packages/testing#readme",
  "bugs": "https://github.com/vishwakarma-dev/vishwakarma/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@vishwakarma/core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "axe-core": "^4.10.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "vitest": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
