{
  "name": "@vishwakarma/tokens",
  "version": "0.1.0",
  "description": "Design token schema, the default token set, and transforms to CSS, Tailwind, and TypeScript.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "vishwakarma",
    "design-tokens",
    "css-variables",
    "theming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogvidwankhede/vishwakarma.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/yogvidwankhede/vishwakarma/tree/main/packages/tokens#readme",
  "bugs": "https://github.com/yogvidwankhede/vishwakarma/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@vishwakarma/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
